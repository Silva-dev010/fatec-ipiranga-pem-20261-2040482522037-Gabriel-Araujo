#include <stdio.h>

struct Aluno {

    char nome[50];
    int matricula;
    float media;
};

int main() {

    struct Aluno aluno = {"Gabriel", 12345, 8.5};

    printf("Endereco do nome: %p\n", &aluno.nome);
    printf("Endereco da matricula: %p\n", &aluno.matricula);
    printf("Endereco da media: %p\n", &aluno.media);

    /*
    Os enderecos podem parecer consecutvos,
    mas nem sempre sao exatamente grudados.

    Isso acontece por causa do alinhamento
    de memorla feito pelo compilador.
    */

    return 0;
}
